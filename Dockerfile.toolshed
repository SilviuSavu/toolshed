FROM rust:1.91-bookworm AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY src/ src/
RUN cargo build --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl jq gnupg git python3 python3-pip python3-venv pipx \
        build-essential pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/root/.local/bin:${PATH}"

# Rust toolchain (for cargo crate installs and cargo-mcp runtime)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain 1.91.0 --profile minimal
ENV PATH="/root/.cargo/bin:${PATH}"

# mise — manages node, npm packages, pip packages, cargo crates, github releases
RUN curl https://mise.run | sh \
    && ln -s /root/.local/bin/mise /usr/local/bin/mise

# Install all tools declared in .mise.toml and set as global defaults
COPY .mise.toml /root/.mise.toml
RUN cd /root && mise trust && mise install --yes 2>&1 \
    && mkdir -p /root/.config/mise \
    && cp /root/.mise.toml /root/.config/mise/config.toml

# Activate mise shims so toolshed can find all installed binaries
ENV PATH="/root/.local/share/mise/shims:${PATH}"

# huly-mcp: npm install with --before to avoid broken @hcengineering/*@0.7.382
RUN cd /root && mise exec -- npm install -g @firfi/huly-mcp@0.1.41 --before="2026-03-01T00:00:00.000Z"

# Toolshed binary
COPY --from=builder /build/target/release/toolshed /usr/local/bin/toolshed

# Tool manifests and scripts
COPY tools/ /root/.toolshed/tools/

# Introspection support for python-checker (needs a directory to exist)
RUN mkdir -p /workspace

ENTRYPOINT ["/vault-env.sh"]
CMD ["toolshed", "serve", "--port", "8081"]
