  "category": "database",
  "type": "mcp",
  "max_output": 32768,
  "mcp": {
    "transport": "stdio",
    "command": "redis-mcp-server",
    "args": [],
    "env": {
      "REDIS_URL": "${REDIS_URL:-redis://host.docker.internal:6379}"
    }
  },
  "health": "which redis-mcp-server",
  "tier": "cold"
}
