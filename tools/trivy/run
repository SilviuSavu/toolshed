#!/usr/bin/env bash
set -euo pipefail

die() { echo "ERROR: $*" >&2; exit 1; }

cmd_fs() {
    local target="${1:-}"
    [[ -n "$target" ]] || die "usage: trivy fs <target> [--severity ...] [--format ...] [--scanners ...]"
    shift || true

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --severity)  args+=(--severity "$2"); shift 2 ;;
            --format)    args+=(--format "$2"); shift 2 ;;
            --scanners)  args+=(--scanners "$2"); shift 2 ;;
            *)           shift ;;
        esac
    done

    trivy fs "${args[@]}" "$target" 2>/dev/null
}

cmd_repo() {
    local url="${1:-}"
    [[ -n "$url" ]] || die "usage: trivy repo <url> [--branch ...] [--severity ...]"
    shift || true

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --branch)    args+=(--branch "$2"); shift 2 ;;
            --severity)  args+=(--severity "$2"); shift 2 ;;
            *)           shift ;;
        esac
    done

    trivy repo "${args[@]}" "$url" 2>/dev/null
}

cmd_sbom() {
    local target="${1:-}"
    [[ -n "$target" ]] || die "usage: trivy sbom <target> [--format ...]"
    shift || true

    local format="cyclonedx"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --format) format="$2"; shift 2 ;;
            *)        shift ;;
        esac
    done

    trivy fs --format "$format" --scanners "" "$target" 2>/dev/null
}

cmd_image() {
    local image="${1:-}"
    [[ -n "$image" ]] || die "usage: trivy image <image> [--severity ...] [--format ...]"
    shift || true

    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --severity)  args+=(--severity "$2"); shift 2 ;;
            --format)    args+=(--format "$2"); shift 2 ;;
            *)           shift ;;
        esac
    done

    trivy image "${args[@]}" "$image" 2>/dev/null
}

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    fs)    cmd_fs "$@" ;;
    repo)  cmd_repo "$@" ;;
    sbom)  cmd_sbom "$@" ;;
    image) cmd_image "$@" ;;
    *)     die "unknown command: $COMMAND (available: fs, repo, sbom, image)" ;;
esac
