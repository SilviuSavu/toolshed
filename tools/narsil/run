#!/usr/bin/env bash
set -euo pipefail

VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
VAULT_TOKEN="${VAULT_TOKEN:-toolshed-dev-token}"

_or_data=$(curl -s -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/secret/data/openrouter") || {
    echo "ERROR: cannot reach Vault at $VAULT_ADDR for openrouter secret" >&2
    exit 1
}
export EMBEDDING_API_KEY=$(echo "$_or_data" | jq -r ".data.data.api_key")
export EMBEDDING_SERVER_ENDPOINT="https://openrouter.ai/api/v1/embeddings"
unset _or_data
[[ -n "$EMBEDDING_API_KEY" && "$EMBEDDING_API_KEY" != "null" ]] || {
    echo "ERROR: openrouter api_key not found in Vault" >&2
    exit 1
}

exec narsil-mcp \
  --git --persist --call-graph --lsp \
  --neural --neural-model "qwen/qwen3-embedding-8b"
