#!/usr/bin/env bash
set -euo pipefail

TOOLSHED_URL="${TOOLSHED_URL:-http://localhost:8081}"

ts_rpc() {
    curl -sf --max-time 30 -X POST "$TOOLSHED_URL" \
        -H 'Content-Type: application/json' \
        -d "$1"
}

cmd_prefixes() {
    ts_rpc '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
        | jq -r '.result.tools[].name' \
        | sed 's/__.*$//' \
        | sort -u
}

cmd_list() {
    local prefix="${1:-}"
    if [[ -z "$prefix" ]]; then
        ts_rpc '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
            | jq -r '.result.tools[] | "\(.name)\t\(.description // "")"' \
            | column -t -s $'\t'
        return
    fi
    ts_rpc '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
        | jq -r --arg p "${prefix}__" '.result.tools[] | select(.name | startswith($p)) | "\(.name)\t\(.description // "")"' \
        | column -t -s $'\t'
}

cmd_search() {
    local query="${1:?usage: ts search <query>}"
    ts_rpc '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
        | jq -r --arg q "$query" '.result.tools[] | select((.name + " " + (.description // "")) | ascii_downcase | contains($q | ascii_downcase)) | "\(.name)\t\(.description // "")"' \
        | column -t -s $'\t'
}

cmd_schema() {
    local tool="${1:?usage: ts schema <tool_name>}"
    ts_rpc '{"jsonrpc":"2.0","id":1,"method":"tools/list"}' \
        | jq --arg t "$tool" '.result.tools[] | select(.name == $t)'
}

cmd_call() {
    local tool="${1:?usage: ts call <tool_name> [--arg val ...]}"
    shift

    local args="{}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --*)
                local key="${1#--}"
                local val="${2:?missing value for $1}"
                args=$(echo "$args" | jq --arg k "$key" --arg v "$val" '. + {($k): $v}')
                shift 2
                ;;
            *)
                echo "ERROR: unexpected positional arg: $1" >&2
                exit 1
                ;;
        esac
    done

    local response
    response=$(ts_rpc "$(jq -n \
        --arg name "$tool" \
        --argjson args "$args" \
        '{jsonrpc:"2.0",id:1,method:"tools/call",params:{name:$name,arguments:$args}}'
    )")

    local is_error
    is_error=$(echo "$response" | jq -r '.result.isError // false')
    if [[ "$is_error" == "true" ]]; then
        echo "$response" | jq -r '.result.content[0].text // "unknown error"' >&2
        return 1
    fi

    echo "$response" | jq -r '.result.content[0].text // empty'
}

case "${1:-}" in
    prefixes) cmd_prefixes ;;
    list)     shift; cmd_list "$@" ;;
    search)   shift; cmd_search "$@" ;;
    schema)   shift; cmd_schema "$@" ;;
    call)     shift; cmd_call "$@" ;;
    *)
        echo "ts — toolshed CLI for progressive tool discovery"
        echo ""
        echo "Commands:"
        echo "  ts prefixes              list tool server prefixes"
        echo "  ts list [prefix]         list tools, optionally filtered by prefix"
        echo "  ts search <query>        search tools by name or description"
        echo "  ts schema <tool_name>    show full schema for a tool"
        echo "  ts call <tool> [--k v]   call a tool with named arguments"
        exit 1
        ;;
esac
