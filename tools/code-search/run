#!/usr/bin/env bash
set -euo pipefail

VAULT_ADDR="${VAULT_ADDR:-http://127.0.0.1:8200}"
VAULT_TOKEN="${VAULT_TOKEN:-}"

die() { echo "ERROR: $*" >&2; exit 1; }

_vault_data=$(curl -s -H "X-Vault-Token: $VAULT_TOKEN" "$VAULT_ADDR/v1/secret/data/sourcegraph" 2>/dev/null) \
    || die "cannot reach Vault at $VAULT_ADDR"
_vault_errors=$(echo "$_vault_data" | jq -r '.errors[0] // empty' 2>/dev/null)
[[ -n "$_vault_errors" ]] && die "Vault error: $_vault_errors"
SG_URL=$(echo "$_vault_data" | jq -r '.data.data.url')
SG_TOKEN=$(echo "$_vault_data" | jq -r '.data.data.token')
unset _vault_data _vault_errors

[[ -n "$SG_URL" && "$SG_URL" != "null" ]] || die "Sourcegraph URL not found in Vault"
[[ -n "$SG_TOKEN" && "$SG_TOKEN" != "null" ]] || die "Sourcegraph token not found in Vault"

graphql() {
    local _resp
    _resp=$(curl -s -H "Authorization: token $SG_TOKEN" \
        -H 'Content-Type: application/json' \
        -X POST "$SG_URL/.api/graphql" \
        -d "$1") || { echo "ERROR: GraphQL request failed (curl exit $?)" >&2; return 1; }
    local _gql_err
    _gql_err=$(echo "$_resp" | jq -r '.errors[0].message // empty' 2>/dev/null)
    if [[ -n "$_gql_err" ]]; then
        echo "ERROR: GraphQL: $_gql_err" >&2
    fi
    echo "$_resp"
}

cmd_query() {
    local query="${1:-}"
    [[ -n "$query" ]] || die "usage: code-search query <query> [--count N]"

    local count="30"
    shift || true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --count) count="$2"; shift 2 ;;
            *) shift ;;
        esac
    done

    local gql_query
    gql_query=$(jq -n --arg q "$query" --argjson n "$count" '{
        query: "query Search($q: String!) { search(query: $q, version: V3, patternType: keyword) { results { resultCount results { ... on FileMatch { repository { name } file { path } lineMatches { preview lineNumber } } } } } }",
        variables: { q: ($q + " count:" + ($n | tostring)) }
    }')

    local response
    response=$(graphql "$gql_query") || die "Sourcegraph search request failed"

    echo "$response" | jq -r '
        .data.search.results as $r |
        "Found \($r.resultCount) results\n" +
        ([$r.results[] |
            select(.repository) |
            "\(.repository.name) — \(.file.path)" +
            (if .lineMatches then
                "\n" + ([.lineMatches[:5][] |
                    "  L\(.lineNumber): \(.preview)"] | join("\n"))
            else "" end)
        ] | join("\n\n"))
    ' 2>/dev/null || echo "$response" | jq -r '.data.search.results // "no results"'
}

cmd_health() {
    local response
    response=$(graphql '{"query":"{ currentUser { username } }"}') || die "cannot reach Sourcegraph"
    local user
    user=$(echo "$response" | jq -r '.data.currentUser.username // "anonymous"')
    echo "OK: connected to $SG_URL as $user"
}

COMMAND="${1:-}"
shift || true

case "$COMMAND" in
    query)  cmd_query "$@" ;;
    health) cmd_health ;;
    *)      die "unknown command: $COMMAND (available: query, health)" ;;
esac
